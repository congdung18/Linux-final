# Web configuration
APP_DOMAIN=app.linux.local
STATUS_DOMAIN=status.linux.local

# Backend configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=5000

# Network configuration
HTTP_PORT=80
HTTPS_PORT=443
SSH_PORT=2222

# TLS configuration
TLS_DAYS=365
TLS_KEY_BITS=2048
TLS_COUNTRY=VN
TLS_ORGANIZATION="Linux Final Lab"

# Fail2ban configuration
F2B_MAXRETRY=3
F2B_FINDTIME=600
F2B_BANTIME=600

# Integration
BACKEND_SERVICE=myapp
