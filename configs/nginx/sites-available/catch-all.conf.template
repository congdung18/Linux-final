server {
    server_tokens off;
    listen ${HTTP_PORT} default_server;
    listen [::]:${HTTP_PORT} default_server;

    server_name _;

    return 404;
}

server {
    server_tokens off;
    listen ${HTTPS_PORT} ssl default_server;
    listen [::]:${HTTPS_PORT} ssl default_server;

    server_name _;

    include snippets/linux-lab-tls.conf;

    return 404;
}
